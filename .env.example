# Anthropic (server only — never exposed to the browser)
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Abuse controls
DAILY_AI_LIMIT=25            # AI actions per user per day
DAILY_SEARCH_LIMIT=5         # live job searches per user per day (each costs ~$0.05)
ALLOWED_EMAIL_DOMAINS=       # optional, e.g. miamioh.edu — blank = anyone with an invite link can sign up
NEXT_PUBLIC_APP_NAME=OfferDesk
